# ===================================================================
# FRIDAY - Зразковий файл конфігурації секретів (.env)
# Скопіюйте цей файл як .env: copy .env.example .env
# ===================================================================

# Обов'язково для хмарного STT та LLM-парсингу (Google Gemini AI Studio):
# Отримати безкоштовно на https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Опціонально для надсилання повідомлень у Telegram:
# Отримати на https://my.telegram.org (Розділ API development tools)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
